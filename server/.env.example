# Fixconnexion server configuration - copy to .env and fill in

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Auth (CHANGE THESE in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=change-me-to-a-long-random-string

# SMTP (Gmail, OVH, Infomaniak, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@fixconnexion.com
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM="Fixconnexion <hello@fixconnexion.com>"

# Notification - email qui recoit les notifications internes
NOTIFY_EMAIL=hello@fixconnexion.com
